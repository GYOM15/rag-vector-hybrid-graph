# Copie ce fichier en `.env` et remplis les valeurs voulues.
# `.env` est chargé automatiquement par l'app et le benchmark.

# --- Backend LLM pour la GÉNÉRATION (les 3 stacks) ---
LLM_PROVIDER=ollama                 # ollama | openai | huggingface
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
HF_MODEL=google/flan-t5-base
# LLM_TIMEOUT=120                   # délai max (s) d'un appel ollama/openai

# --- OpenAI ---
# Requis par RAGAS (le benchmark s'en sert comme LLM-juge).
# Sert aussi à la génération si LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Laisser commenté pour le VRAI OpenAI (RAGAS).
# Décommenter et pointer vers un serveur vLLM uniquement pour la génération.
# Dans l'app, la clé ci-dessus n'est envoyée QU'À cette URL : une autre URL saisie
# dans la barre latérale n'est utilisée qu'avec une clé saisie dans la même session.
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Démo publique (ex. Hugging Face Space) ---
# Toutes les sessions des visiteurs partagent UN processus. PUBLIC_DEMO=1 fige le
# backend sur celui configuré ici (pas de choix de fournisseur, modèle, URL ni clé
# côté visiteur) et désactive le benchmark RAGAS en ligne. Obligatoire si l'app est
# publique — le propriétaire peut alors utiliser LLM_PROVIDER=openai avec sa clé :
# les visiteurs ne peuvent pas rediriger l'endpoint.
# Non défini, il est activé d'office sur un Hugging Face Space (HF y définit SPACE_ID) ;
# PUBLIC_DEMO=0 le désactive explicitement (ex. Space privé).
# PUBLIC_DEMO=1
# DEMO_ARTICLES=500                 # taille du corpus (nombre d'articles Wikipédia)
